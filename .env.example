# Flask configuration
# Generate a strong value, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Set to true when the app is served over HTTPS (recommended in production).
SESSION_COOKIE_SECURE=false
# Public port used by Docker Compose on the host.
APP_PORT=5000

# Database
# Leave DATABASE_URL empty for local development with SQLite.
# Docker Compose builds the MariaDB URL automatically from the MARIADB_* values.
DATABASE_URL=
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=calendar
MARIADB_USER=calendar_user
MARIADB_PASSWORD=
